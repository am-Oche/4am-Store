{
  "name": "4am-originals",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "sync:catlog": "tsx scripts/sync-catlog.ts",
    "sync:catlog:dry": "tsx scripts/sync-catlog.ts --dry",
    "import:file": "tsx scripts/import-file.ts",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "validate:catalog": "tsx -e \"import('./lib/catalog/schema').then(m=>m.CatalogSchema.parse(require('./data/catalog.json'))).then(()=>console.log('catalog ok'))\""
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
