    "framer-motion": "^11.11.0",
    "lenis": "^1.1.13",
    "next": "^14.2.15",
    "next-auth": "^4.24.8",
    "next-mdx-remote": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "server-only": "^0.0.1",
    "sharp": "^0.33.5",
    "tailwind-merge": "^2.5.3",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "autoprefixer": "^10.4.20",
    "csv-parse": "^5.5.6",
    "postcss": "^8.4.47",
